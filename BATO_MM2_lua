    function rt:CheckIfPlayerIsInARound()
        if not self:MainGUI() then return false end
        if self:MainGUI().Game.Timer.Visible then return true end
        if self:MainGUI().Game.EarnedXP.Visible then return true end
        return false
    end

    function rt:CheckIfPlayerWasInARound()
