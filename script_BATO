local function autoCollect()
    if not autoCollectEnabled then return end
    for _, v in pairs(ws:GetDescendants()) do
        if v:IsA("Model") and v:FindFirstChild("Coin") then
            local coin = v:FindFirstChild("Coin")
            if coin:IsA("BasePart") then
                character.HumanoidRootPart.CFrame = CFrame.new(coin.Position)
                wait(0.05)
            end
        end
        if v:IsA("Model") and v:FindFirstChild("Box") then
            local box = v:FindFirstChild("Box")
            if box:IsA("BasePart") then
                character.HumanoidRootPart.CFrame = CFrame.new(box.Position)
                wait(0.05)
            end
        end
    end
end

-- ===== كشف القاتل والشريف =====
local function detectRoles()
    local murderer = nil
    local sheriff = nil
    for _, v in pairs(game.Players:GetPlayers()) do
        if v ~= player and v.Character then
            if v.Character:FindFirstChild("Murderer") then
                murderer = v
            end
            if v.Character:FindFirstChild("Sheriff") then
                sheriff = v
            end
        end
    end
    return murderer, sheriff
end

