-- زر طيران
local flyBtn = createButton("✈ طيران (WASD)", 440, function()
    flyEnabled = not flyEnabled
    flyBtn.Text = "✈ طيران " .. (flyEnabled and "ON" or "OFF")
    flyBtn.BackgroundColor3 = flyEnabled and Color3.fromRGB(50, 200, 50) or Color3.fromRGB(200, 50, 50)
    if flyEnabled then
        local bv = Instance.new("BodyVelocity")
        bv.MaxForce = Vector3.new(1, 1, 1) * 100000
        bv.Velocity = Vector3.new(0, 50, 0)
        bv.Parent = hrp
        humanoid.PlatformStand = true
        uis.InputBegan:Connect(function(input)
            if flyEnabled and input.UserInputType == Enum.UserInputType.Keyboard then
                if input.KeyCode == Enum.KeyCode.W then bv.Velocity = hrp.CFrame.LookVector * 100 end
                if input.KeyCode == Enum.KeyCode.S then bv.Velocity = -hrp.CFrame.LookVector * 100 end
                if input.KeyCode == Enum.KeyCode.A then bv.Velocity = -hrp.CFrame.RightVector * 100 end
                if input.KeyCode == Enum.KeyCode.D then bv.Velocity = hrp.CFrame.RightVector * 100 end
                if input.KeyCode == Enum.KeyCode.Space then bv.Velocity = Vector3.new(0, 100, 0) end
                if input.KeyCode == Enum.KeyCode.LeftShift then bv.Velocity = Vector3.new(0, -100, 0) end
            end
        end)
    else
        humanoid.PlatformStand = false
        for _, v in pairs(hrp:GetChildren()) do
            if v:IsA("BodyVelocity") then v:Destroy() end
        end
    end
end)

