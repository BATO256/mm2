-- ===== كشف القاتل والشريف =====
local function detectRoles()
    local murderer, sheriff = nil, nil
    for _, v in pairs(game.Players:GetPlayers()) do
        if v ~= player and v.Character then
            if v.Character:FindFirstChild("Murderer") then murderer = v end
            if v.Character:FindFirstChild("Sheriff") then sheriff = v end
        end
    end
    return murderer, sheriff
end

-- ===== Aimbot =====
rs.RenderStepped:Connect(function()
    if aimbotEnabled then
        local target = murdererDetected
        if not target then
            local closest = math.huge
            for _, v in pairs(game.Players:GetPlayers()) do
                if v ~= player and v.Character and v.Character:FindFirstChild("HumanoidRootPart") then
                    local dist = (v.Character.HumanoidRootPart.Position - hrp.Position).Magnitude
                    if dist < closest then
                        closest = dist
                        target = v
                    end
                end
            end
        end
        if target and target.Character then
            hrp.CFrame = CFrame.lookAt(hrp.Position, target.Character.HumanoidRootPart.Position)
        end
    end
end)

